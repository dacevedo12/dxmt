d3d12_submission_model_native_test = executable(
  'dxmt-d3d12-submission-model-tests',
  files(
    'd3d12_submission_model.cpp',
    '../../tools/audit/d3d12_submission_model_spec.cpp',
  ),
  include_directories: [include_directories('../../include')],
  native: true,
  install: false,
)

test(
  'd3d12-submission-model',
  d3d12_submission_model_native_test,
  suite: ['unit', 'native', 'd3d12-model'],
  timeout: 30,
)

# Copy-geometry boundary spec. The planning helpers are pure arithmetic over
# application-supplied footprints, boxes and tile offsets, so they run native
# against the real translation units; only the logging sink, the winemetal
# device queries and dxmt::Buffer's refcount are stubbed inside the spec.
d3d12_copy_geometry_native_test = executable(
  'dxmt-d3d12-copy-geometry-tests',
  files(
    'd3d12_copy_footprint.cpp',
    'd3d12_subresource_geometry.cpp',
    'd3d12_tile_copy_plan.cpp',
    'd3d12_indirect_topology.cpp',
    'd3d12_tile_mapping.cpp',
    '../dxmt/dxmt_format.cpp',
    '../util/log/log.cpp',
    '../util/util_env.cpp',
    '../util/thread.cpp',
    '../../tools/audit/d3d12_copy_geometry_spec.cpp',
  ),
  include_directories: [include_directories(
    '.',
    '../dxmt',
    '../dxgi',
    '../util',
    '../winemetal4',
    '../airconv',
    '../../include',
    '../../include/native/windows',
    '../../include/native/directx',
    '../../libs',
  )],
  cpp_args: ['-DDXMT_DX12_METAL4=1', '-DNOMINMAX', '-D_WIN32_WINNT=0xa00'],
  native: true,
  install: false,
)

test(
  'd3d12-copy-geometry',
  d3d12_copy_geometry_native_test,
  suite: ['unit', 'native', 'd3d12-model'],
  env: {'DXMT_LOG_PATH': 'none'},
  timeout: 30,
)

d3d12_ld_args      = ['-L' + windows_native_install_dir]
d3d12_link_depends = []
d3d12_cpp_args     = ['-DDXMT_DX12_METAL4=1']
if get_option('b_coverage') and cpp.get_id() == 'gcc'
  d3d12_cpp_args += ['-Wa,-mbig-obj']
endif

d3d12_dll = shared_library('d3d12', d3d12_src, d3d12_res,
  name_prefix         : '',
  dependencies        : [
    winemetal4_dep,
    dxmt12_dep,
    dxgi_dep,
    dxbc_parser_dep,
    dxil_parser_dep,
    airconv_dx12_metal4_forward_dep,
    util_dep ],
  include_directories : [ dxmt_include_path ],
  cpp_args            : d3d12_cpp_args,
  install             : true,
  install_dir         : windows_native_install_dir,
  install_tag         : 'runtime-metal4',
  vs_module_defs      : 'd3d12.def',
  link_args           : d3d12_ld_args,
  link_depends        : [ d3d12_link_depends ],
)

d3d12core_dll = shared_library('d3d12core', d3d12core_src,
  name_prefix         : '',
  dependencies        : [
    dxgi_dep,
    util_dep ],
  include_directories : [ dxmt_include_path ],
  install             : true,
  install_dir         : windows_native_install_dir,
  install_tag         : 'runtime-metal4',
  vs_module_defs      : 'd3d12core.def',
  link_args           : d3d12_ld_args,
  link_depends        : [ d3d12_link_depends ],
)

d3d12_dep = declare_dependency(
  link_with           : [ d3d12_dll ],
  include_directories : [ dxmt_include_path ],
)

if wine_builtin_dll
d3d12_postprocess = custom_target('postprocess_libd3d12',
  input : d3d12_dll,
  output: 'd3d12.dll.postproc',
  command : [ winebuild_command, '--builtin', '@INPUT@' ],
  depends : d3d12_dll,
  build_by_default : true
)
d3d12_postprocess_targets += [d3d12_postprocess]
endif

if wine_builtin_dll
d3d12core_postprocess = custom_target('postprocess_libd3d12core',
  input : d3d12core_dll,
  output: 'd3d12core.dll.postproc',
  command : [ winebuild_command, '--builtin', '@INPUT@' ],
  depends : d3d12core_dll,
  build_by_default : true
)
d3d12_postprocess_targets += [d3d12core_postprocess]
endif
